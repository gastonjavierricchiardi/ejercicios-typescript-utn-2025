{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "rootDir": ".",
        "outDir": "./dist",
        "noEmitOnError": true,
        "sourceMap": true,
        "removeComments": true,
        "esModuleInterop": true,
        "strict": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "useUnknownInCatchVariables": false,
        "experimentalDecorators": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "ejercicios/**/*.ts",
        "dictadoDeClases/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "fixtures",
        "tmp"
    ],
    "ts-node": {
        "preferTsExts": true
    }
}
