                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\nclass Navio {\n  -_nombre: string\n  -_flotabilidad: number\n  -_solidez: number\n  -_estabilidad: number\n  -_velocidadCrucero: number\n  +getNombre(): string\n  +setNombre(value: string): void\n  +getFlotabilidad(): number\n  +setFlotabilidad(value: number): void\n  +getSolidez(): number\n  +setSolidez(value: number): void\n  +getEstabilidad(): number\n  +setEstabilidad(value: number): void\n  +getVelocidadCrucero(): number\n  +setVelocidadCrucero(value: number): void\n}\n\nclass Flota {\n  -_navios: Navio[]\n  +agregarNavio(navio: Navio): void\n  +getNavios(): Navio[]\n  +cantidad(): number\n  +buscarPorNombre(nombre: string): Navio\n  +mostrarResumen(): void\n}\n\nclass IArmado {\n  +getPotenciaFuego(): number\n  +setPotenciaFuego(value: number): void\n}\n\nclass IBlindado {\n  +getBlindaje(): number\n  +setBlindaje(value: number): void\n}\n\nclass IHospital {\n  +getCapacidadPacientes(): number\n  +setCapacidadPacientes(value: number): void\n}\n\nclass IMotorFueraBorda {\n  +getMotorFueraBorda(): boolean\n  +setMotorFueraBorda(value: boolean): void\n}\n\nclass IConGrua {\n  +getCapacidadGruaKg(): number\n  +setCapacidadGruaKg(value: number): void\n}\n\nclass Acorazado {\n  -_blindaje: number\n  -_potenciaFuego: number\n  +getBlindaje(): number\n  +setBlindaje(value: number): void\n  +getPotenciaFuego(): number\n  +setPotenciaFuego(value: number): void\n}\n\nclass Destructor {\n  -_potenciaFuego: number\n  -_maniobrabilidad: number\n  -_velocidadMaxima: number\n  +getVelocidadMaxima(): number\n  +setVelocidadMaxima(value: number): void\n  +getManiobrabilidad(): number\n  +setManiobrabilidad(value: number): void\n  +getPotenciaFuego(): number\n  +setPotenciaFuego(value: number): void\n}\n\nclass BarcoHospital {\n  -_instance: BarcoHospital\n  -_capacidadPacientes: number\n  +getInstance(): BarcoHospital\n  +getCapacidadPacientes(): number\n  +setCapacidadPacientes(value: number): void\n}\n\nclass LanchaMedica {\n  -_maniobrabilidad: number\n  -_motorFueraBorda: boolean\n  -_capacidadGruaKg: number\n  +getManiobrabilidad(): number\n  +setManiobrabilidad(value: number): void\n  +getMotorFueraBorda(): boolean\n  +setMotorFueraBorda(value: boolean): void\n  +getCapacidadGruaKg(): number\n  +setCapacidadGruaKg(value: number): void\n}\n\nFlota o-- \&quot;0..*\&quot; Navio\n\nNavio &lt;|-- Acorazado\nNavio &lt;|-- Destructor\nNavio &lt;|-- BarcoHospital\nNavio &lt;|-- LanchaMedica\n\nIArmado &lt;|.. Acorazado\nIBlindado &lt;|.. Acorazado\n\nIArmado &lt;|.. Destructor\n\nIHospital &lt;|.. BarcoHospital\n\nIMotorFueraBorda &lt;|.. LanchaMedica\nIConGrua &lt;|.. LanchaMedica\n\nnote for BarcoHospital \&quot;Singleton\\n- constructor privado\\n- getInstance() retorna unica instancia\\n- nombre fijo: Sibelancia\\n- capacidad: 75\&quot;&quot;&#xa;}" id="0RbfupDAR6xDZboUt0yh-1">
