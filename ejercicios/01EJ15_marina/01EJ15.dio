                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n\n    class Flota {\n        -_navios: Navio[]\n        +getNavios() Navio[]\n        +agregarNavio(navio: Navio) void\n        +cantidad() number\n        +buscarPorNombre(nombre: string) Navio\n        +mostrarResumen() void\n    }\n\n    class Navio {\n        &lt;&lt;abstract&gt;&gt;\n        -_nombre: string\n        -_flotabilidad: number\n        -_solidez: number\n        -_estabilidad: number\n        -_velocidadCrucero: number\n        +Navio(nombre: string, flotabilidad: number, solidez: number, estabilidad: number, velocidadCrucero: number)\n        +getNombre() string\n        +setNombre(value: string) void\n        +getFlotabilidad() number\n        +setFlotabilidad(value: number) void\n        +getSolidez() number\n        +setSolidez(value: number) void\n        +getEstabilidad() number\n        +setEstabilidad(value: number) void\n        +getVelocidadCrucero() number\n        +setVelocidadCrucero(value: number) void\n    }\n\n    class Acorazado {\n        -_blindaje: number\n        -_potenciaFuego: number\n        +Acorazado(nombre: string, flotabilidad: number, solidez: number, estabilidad: number, velocidadCrucero: number, blindaje: number, potenciaFuego: number)\n        +getBlindaje() number\n        +setBlindaje(value: number) void\n        +getPotenciaFuego() number\n        +setPotenciaFuego(value: number) void\n    }\n\n    class Destructor {\n        -_potenciaFuego: number\n        -_maniobrabilidad: number\n        -_velocidadMaxima: number\n        +Destructor(nombre: string, flotabilidad: number, solidez: number, estabilidad: number, velocidadCrucero: number, potenciaFuego: number, maniobrabilidad: number, velocidadMaxima: number)\n        +getVelocidadMaxima() number\n        +setVelocidadMaxima(value: number) void\n        +getManiobrabilidad() number\n        +setManiobrabilidad(value: number) void\n        +getPotenciaFuego() number\n        +setPotenciaFuego(value: number) void\n    }\n\n    class BarcoHospital {\n        -_INSTANCE: BarcoHospital$\n        -_capacidadPacientes: number\n        -BarcoHospital()\n        +getInstance() BarcoHospital$\n        +getCapacidadPacientes() number\n        +setCapacidadPacientes(value: number) void\n    }\n\n    class LanchaMedica {\n        -_maniobrabilidad: number\n        -_motorFueraBorda: boolean\n        -_capacidadGruaKg: number\n        +LanchaMedica(nombre: string, flotabilidad: number, solidez: number, estabilidad: number, velocidadCrucero: number, maniobrabilidad: number, motorFueraBorda: boolean, capacidadGruaKg: number)\n        +getManiobrabilidad() number\n        +setManiobrabilidad(value: number) void\n        +getMotorFueraBorda() boolean\n        +setMotorFueraBorda(value: boolean) void\n        +getCapacidadGruaKg() number\n        +setCapacidadGruaKg(value: number) void\n    }\n\n    class IArmado {\n        &lt;&lt;interface&gt;&gt;\n        +getPotenciaFuego() number\n        +setPotenciaFuego(value: number) void\n    }\n\n    class IBlindado {\n        &lt;&lt;interface&gt;&gt;\n        +getBlindaje() number\n        +setBlindaje(value: number) void\n    }\n\n    class IHospital {\n        &lt;&lt;interface&gt;&gt;\n        +getCapacidadPacientes() number\n        +setCapacidadPacientes(value: number) void\n    }\n\n    class IMotorFueraBorda {\n        &lt;&lt;interface&gt;&gt;\n        +getMotorFueraBorda() boolean\n        +setMotorFueraBorda(value: boolean) void\n    }\n\n    class IConGrua {\n        &lt;&lt;interface&gt;&gt;\n        +getCapacidadGruaKg() number\n        +setCapacidadGruaKg(value: number) void\n    }\n\n    Navio &lt;|-- Acorazado\n    Navio &lt;|-- Destructor\n    Navio &lt;|-- BarcoHospital\n    Navio &lt;|-- LanchaMedica\n\n    IArmado &lt;|.. Acorazado\n    IBlindado &lt;|.. Acorazado\n\n    IArmado &lt;|.. Destructor\n\n    IHospital &lt;|.. BarcoHospital\n\n    IMotorFueraBorda &lt;|.. LanchaMedica